{
  "name": "@matthew-dresden/opencode-cross-session-messaging",
  "version": "1.0.0",
  "description": "OpenCode plugin for cross-session messaging — local file IPC or cross-device relay via HTTP polling. Sessions discover, ask, and reply across machines.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matthew-dresden/opencode-cross-session-messaging.git"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "multi-agent",
    "cross-session",
    "cross-device",
    "relay",
    "messaging"
  ],
  "main": "src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts"
    },
    "./tui": {
      "import": "./tui.tsx"
    }
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "web/dist",
    "tui.tsx",
    "README.md",
    "README.zh-CN.md",
    "SKILL.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "opencode": ">=1.3.13",
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "tsc --noEmit",
    "relay": "bun run src/relay/cli.ts",
    "relay:start": "bun run src/relay/cli.ts",
    "dashboard:dev": "vite --config web/vite.config.ts",
    "dashboard:build": "vite build --config web/vite.config.ts"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.17.4",
    "@opentui/solid": "^0.4.1",
    "solid-js": "^1.9.13"
  },
  "devDependencies": {
    "@opencode/plugin": "^2.0.30",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.3",
    "typescript": "^5.9.3",
    "vite": "^8.1.3",
    "vite-plugin-solid": "^2.11.12"
  }
}
